#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt { flavor = "tap-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        escape_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <15 16>;
        };

        backspace_combo {
            bindings = <&kp BACKSPACE>;
            key-positions = <7 8>;
        };

        delete_combo {
            bindings = <&kp DELETE>;
            key-positions = <8 9>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp A        &kp Z       &kp E         &kp R       &kp T        &kp Y    &kp U         &kp I          &kp O        &kp P
&mt LCTRL Q  &mt LALT S  &mt LSHIFT D  &mt LGUI F  &kp G        &kp H    &mt RSHIFT J  &mt RALT K     &mt RCTRL L  &mt RGUI M
&kp W        &kp X       &kp C         &kp V       &kp B        &kp N    &kp COMMA     &kp SEMICOLON  &kp COLON    &kp SLASH
                                       &lt 1 TAB   &kp SPACE    &kp RET  &lt 2 DELETE
            >;
        };

        lower_layer {
            bindings = <
&kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp LESS_THAN  &kp GREATER_THAN  &kp EQUAL          &kp PLUS
&kp EXCLAMATION       &kp QUESTION           &kp HASH        &kp DOLLAR       &kp PERCENT         &kp AMPERSAND      &kp PIPE       &kp BACKSLASH     &kp ASTERISK       &kp MINUS
&kp UNDERSCORE        &kp TILDE              &kp GRAVE       &kp CARET        &kp AT_SIGN         &kp SLASH          &kp SEMICOLON  &kp COLON         &kp DOUBLE_QUOTES  &kp SQT
                                                             &trans           &kp TAB             &kp BACKSPACE      &trans
            >;
        };

        raise_layer {
            bindings = <
&kp PLUS      &kp MINUS   &kp N7        &kp N8        &kp N9          &kp F9  &kp F10  &kp F11  &kp F12  &trans
&kp ASTERISK  &kp SLASH   &kp NUMBER_4  &kp N5        &kp NUMBER_6    &kp F5  &kp F6   &kp F7   &kp F8   &trans
&kp EQUAL     &kp PERIOD  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp F1  &kp F2   &kp F3   &kp F4   &trans
                                        &trans        &kp N0          &trans  &trans
            >;
        };

        nav_layer {
            bindings = <
&kp ESCAPE  &kp HOME   &kp UP_ARROW  &kp END       &kp DELETE    &trans                &trans                &trans      &trans      &trans
&kp TAB     &kp LEFT   &kp DOWN      &kp RIGHT     &kp BSPC      &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans      &trans      &trans
&kp LCTRL   &kp PG_UP  &kp PG_DN     &kp LEFT_ALT  &kp INS       &kp C_VOL_DN          &kp C_VOLUME_UP       &kp C_MUTE  &kp C_PLAY  &trans
                                     &trans        &trans        &trans                &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
